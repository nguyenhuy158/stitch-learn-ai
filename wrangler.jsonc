{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-english",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-07",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stitch-db",
      "database_id": "90b7f345-12cd-45de-b975-6836a0177e12"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "SSO_ISSUER": "https://auth.huyab.click",
    "SSO_AUDIENCE": "huyab.click"
  }
}
