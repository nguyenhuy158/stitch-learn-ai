{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stitch-learn-ai",
  "main": "worker.js",
  "compatibility_date": "2026-01-07",
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_ME",
      "database_id": "REPLACE_ME"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
