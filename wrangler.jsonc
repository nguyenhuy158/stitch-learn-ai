{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-english",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-07",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "build": {
    "command": "node scripts/build-info.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stitch-db",
      "database_id": "90b7f345-12cd-45de-b975-6836a0177e12"
    }
  ],
  "ai": { "binding": "AI" },
  // Log 500 cua Worker len dashboard (wrangler tail bi chan o mang nay).
  "observability": { "enabled": true },
  "services": [{ "binding": "MAILER", "service": "mailer" }],
  "r2_buckets": [
    { "binding": "VOCAB_IMAGES", "bucket_name": "ai-english-vocab" }
  ],
  // 13:30 UTC = 20:30 gio Viet Nam, cuoi ngay hoc nhung chua qua muon de con kip.
  "triggers": {
    "crons": ["30 13 * * *"]
  },
  "vars": {
    // Model Workers AI cho Mochi. Doi sang "@cf/meta/llama-3.1-8b-instruct"
    // neu can re hon (free tier 10k neurons/ngay).
    "MOCHI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Ten AI Gateway (phai tao truoc trong dashboard, cung account). Bo trong
    // = goi Workers AI thang, khong co log/cache cua gateway.
    "AI_GATEWAY": "",
    "SSO_ISSUER": "https://auth.huyab.click",
    "SSO_AUDIENCE": "huyab.click"
  }
}
